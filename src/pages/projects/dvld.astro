---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import SpecularButton from "@/React/SpecularButton.tsx";
import MaskedHeading from "@/React/MaskedHeading.tsx";
import ShinyText from "@/React/ShinyText.tsx";
import ElectricBorder from "@/React/ElectricBorder.tsx";
import { dvldProject } from "@/data/portfolio";
---

<Layout
  title="DVLD System — Architecture & Case Study | Ayhm Mohammed Obeidat"
  description="Detailed technical overview of the DVLD Driving & Vehicle License Department System built by Ayhm Mohammed Obeidat with .NET 8, ASP.NET Core Web API, EF Core, SQL Server, and React."
>
  <Nav />

  <main class="text-[var(--white)] pt-24 md:pt-36 pb-16">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb / Back -->
      <div class="mb-8">
        <SpecularButton
          client:load
          href="/#projects"
          size="sm"
          radius={12}
          tint="#ffffff"
          tintOpacity={0.04}
          textColor="#f5f5f5"
          lineColor="#ffffff"
          baseColor="#525252"
          intensity={1}
          idleIntensity={0.35}
          shineSize={10}
          shineFade={34}
          thickness={1.2}
          glow={0.8}
          followMouse
          proximity={250}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-4 text-[var(--sec)]"
            aria-hidden="true"
          >
            <path
              d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"
            ></path>
          </svg>
          <span>Back to Portfolio</span>
        </SpecularButton>
      </div>

      <!-- Header -->
      <header class="space-y-6 pb-12 md:pb-16">
        <p class="text-lg">
          <ShinyText
            text="Project Case Study"
            color="#a476ff"
            shineColor="#f3ecff"
            speed={4}
            shineWidth={70}
            softness={0.8}
            trigger="loop"
            delay={0.7}
            angle={120}
            bands={1}
            glow={0}
            direction="left"
            easing="smooth"
          />
        </p>

        <MaskedHeading
          client:load
          tag="h1"
          text={dvldProject.name}
          fillScale={1.25}
          parallax={26}
          reveal="scale"
          trigger="mount"
          spotlight={false}
          spotlightRadius={180}
          outline={false}
          duration={1.1}
          stagger={0.09}
          drift={18}
          hoverZoom={0}
          align="left"
          brightness={1}
          saturation={1}
          grayscale={false}
          outlineWidth={1}
          weight={700}
          tracking={-0.03}
          lineHeight={1.06}
          textScale={0.048}
          tint="#f43f5e"
        />

        <p class="text-base md:text-xl text-[var(--white-icon)] leading-relaxed max-w-4xl">
          {dvldProject.description}
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <SpecularButton
            client:load
            target="_blank"
            rel="noopener noreferrer"
            href={dvldProject.repoUrl}
            size="md"
            radius={14}
            tint="#a476ff"
            tintOpacity={0.14}
            textColor="#f5f5f5"
            lineColor="#a476ff"
            baseColor="#525252"
            intensity={1}
            idleIntensity={0.45}
            shineSize={10}
            shineFade={34}
            thickness={1.2}
            glow={1}
            followMouse
            proximity={250}
            className="font-semibold"
          >
            <span>View Source Code</span>
          </SpecularButton>
        </div>
      </header>

      <!-- Technologies -->
      <section class="py-12 md:py-16 border-t border-[#ffffff10]">
        <div class="mb-8">
          <MaskedHeading
            client:visible
            tag="h2"
            text="Technologies Used"
            fillScale={1.25}
            parallax={26}
            reveal="scale"
            trigger="view"
            spotlight={false}
            spotlightRadius={180}
            outline={false}
            duration={1.1}
            stagger={0.09}
            drift={18}
            hoverZoom={0}
            align="left"
            brightness={1}
            saturation={1}
            grayscale={false}
            outlineWidth={1}
            weight={700}
            tracking={-0.03}
            lineHeight={1.06}
            textScale={0.045}
            tint="#f43f5e"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <ElectricBorder
            client:visible
            color="#7df9ff"
            speed={1}
            chaos={0.5}
            spread={0.6}
            strands={3}
            thickness={1.5}
            borderRadius={16}
            className="h-full"
          >
            <div class="h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 hover:border-[#a476ff45] transition-colors duration-300">
              <h3 class="text-sm uppercase tracking-wider text-[var(--sec)] mb-4 font-semibold">
                Backend &amp; Persistence
              </h3>
              <ul class="flex flex-wrap gap-2">
                {
                  dvldProject.backendTechnologies.map((tech) => (
                    <li>
                      <SpecularButton
                        client:visible
                        size="sm"
                        radius={10}
                        tint="#a476ff"
                        tintOpacity={0.08}
                        textColor="#f5f5f5"
                        lineColor="#a476ff"
                        baseColor="#525252"
                        intensity={1}
                        idleIntensity={0.35}
                        shineSize={10}
                        shineFade={34}
                        thickness={1.2}
                        glow={0.8}
                        followMouse
                        proximity={250}
                        className="!px-3 !py-1.5 !text-sm !font-normal !cursor-default"
                      >
                        {tech}
                      </SpecularButton>
                    </li>
                  ))
                }
              </ul>
            </div>
          </ElectricBorder>

          <ElectricBorder
            client:visible
            color="#7df9ff"
            speed={1}
            chaos={0.5}
            spread={0.6}
            strands={3}
            thickness={1.5}
            borderRadius={16}
            className="h-full"
          >
            <div class="h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 hover:border-[#a476ff45] transition-colors duration-300">
              <h3 class="text-sm uppercase tracking-wider text-[var(--white-icon)] mb-4 font-semibold">
                ClientApp Frontend
              </h3>
              <ul class="flex flex-wrap gap-2">
                {
                  dvldProject.frontendTechnologies.map((tech) => (
                    <li>
                      <SpecularButton
                        client:visible
                        size="sm"
                        radius={10}
                        tint="#ffffff"
                        tintOpacity={0.04}
                        textColor="#d4d4d8"
                        lineColor="#ffffff"
                        baseColor="#525252"
                        intensity={1}
                        idleIntensity={0.3}
                        shineSize={10}
                        shineFade={34}
                        thickness={1.2}
                        glow={0.7}
                        followMouse
                        proximity={250}
                        className="!px-3 !py-1.5 !text-sm !font-normal !cursor-default"
                      >
                        {tech}
                      </SpecularButton>
                    </li>
                  ))
                }
              </ul>
            </div>
          </ElectricBorder>
        </div>
      </section>

      <!-- Architecture Highlights -->
      <section class="py-12 md:py-16 border-t border-[#ffffff10]">
        <div class="mb-8">
          <MaskedHeading
            client:visible
            tag="h2"
            text="Architecture Highlights"
            fillScale={1.25}
            parallax={26}
            reveal="scale"
            trigger="view"
            spotlight={false}
            spotlightRadius={180}
            outline={false}
            duration={1.1}
            stagger={0.09}
            drift={18}
            hoverZoom={0}
            align="left"
            brightness={1}
            saturation={1}
            grayscale={false}
            outlineWidth={1}
            weight={700}
            tracking={-0.03}
            lineHeight={1.06}
            textScale={0.045}
            tint="#f43f5e"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          {
            dvldProject.architectureLayers.map((layer, index) => (
              <ElectricBorder
                client:visible
                color="#7df9ff"
                speed={1}
                chaos={0.5}
                spread={0.6}
                strands={3}
                thickness={1.5}
                borderRadius={16}
                className={`h-full ${
                  index === dvldProject.architectureLayers.length - 1
                    ? "md:col-span-2"
                    : ""
                }`}
              >
                <div class="h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-2 hover:border-[#a476ff45] transition-colors duration-300">
                  <div class="flex items-center justify-between gap-2">
                    <h3 class="text-lg font-semibold text-[var(--white)]">
                      {layer.name}
                    </h3>
                    <span class="text-xs font-mono text-[var(--sec)] px-2.5 py-0.5 rounded-md bg-[#1a1a1a] border border-[#a476ff35]">
                      {layer.project}
                    </span>
                  </div>
                  <p class="text-sm text-[var(--white-icon)] leading-relaxed">
                    {layer.description}
                  </p>
                </div>
              </ElectricBorder>
            ))
          }
        </div>

        <ElectricBorder
          client:visible
          color="#7df9ff"
          speed={1}
          chaos={0.5}
          spread={0.6}
          strands={3}
          thickness={1.5}
          borderRadius={16}
        >
          <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 hover:border-[#a476ff45] transition-colors duration-300">
            <h3 class="text-lg font-semibold text-[var(--white)] mb-4">
              Key Design Patterns &amp; Practices
            </h3>
            <ul class="flex flex-wrap gap-2">
              {
                dvldProject.architecturePrinciples.map((item) => (
                  <li>
                    <SpecularButton
                      client:visible
                      size="sm"
                      radius={10}
                      tint="#ffffff"
                      tintOpacity={0.04}
                      textColor="#d4d4d8"
                      lineColor="#ffffff"
                      baseColor="#525252"
                      intensity={1}
                      idleIntensity={0.3}
                      shineSize={10}
                      shineFade={34}
                      thickness={1.2}
                      glow={0.7}
                      followMouse
                      proximity={250}
                      className="!px-3 !py-1.5 !text-sm !font-normal !cursor-default"
                    >
                      {item}
                    </SpecularButton>
                  </li>
                ))
              }
            </ul>
          </div>
        </ElectricBorder>
      </section>

      <!-- Verified Capabilities -->
      <section class="py-12 md:py-16 border-t border-[#ffffff10]">
        <div class="mb-8">
          <MaskedHeading
            client:visible
            tag="h2"
            text="Verified Capabilities"
            fillScale={1.25}
            parallax={26}
            reveal="scale"
            trigger="view"
            spotlight={false}
            spotlightRadius={180}
            outline={false}
            duration={1.1}
            stagger={0.09}
            drift={18}
            hoverZoom={0}
            align="left"
            brightness={1}
            saturation={1}
            grayscale={false}
            outlineWidth={1}
            weight={700}
            tracking={-0.03}
            lineHeight={1.06}
            textScale={0.045}
            tint="#f43f5e"
          />
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            dvldProject.capabilities.map((cap) => (
              <li>
                <SpecularButton
                  client:visible
                  size="md"
                  radius={12}
                  tint="#ffffff"
                  tintOpacity={0.04}
                  textColor="#f5f5f5"
                  lineColor="#a476ff"
                  baseColor="#525252"
                  intensity={1}
                  idleIntensity={0.35}
                  shineSize={10}
                  shineFade={34}
                  thickness={1.2}
                  glow={0.7}
                  followMouse
                  proximity={250}
                  className="w-full !px-4 !py-3 !text-sm !font-normal !cursor-default"
                >
                  <span class="flex w-full items-center gap-2.5 text-left">
                    <span
                      class="size-2 rounded-full bg-[var(--sec)] flex-shrink-0"
                      aria-hidden="true"
                    />
                    <span>{cap}</span>
                  </span>
                </SpecularButton>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Security & Testing -->
      <section class="py-12 md:py-16 border-t border-[#ffffff10]">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <ElectricBorder
            client:visible
            color="#7df9ff"
            speed={1}
            chaos={0.5}
            spread={0.6}
            strands={3}
            thickness={1.5}
            borderRadius={16}
            className="h-full"
          >
            <div class="h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-4 hover:border-[#a476ff45] transition-colors duration-300">
              <h2 class="text-xl md:text-2xl font-medium text-[var(--white)]">
                Security &amp; Session Management
              </h2>
              <ul class="space-y-2.5 text-sm text-[var(--white-icon)]">
                {
                  dvldProject.securityFeatures.map((feat) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-[var(--sec)] mt-0.5" aria-hidden="true">
                        •
                      </span>
                      <span>{feat}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </ElectricBorder>

          <ElectricBorder
            client:visible
            color="#7df9ff"
            speed={1}
            chaos={0.5}
            spread={0.6}
            strands={3}
            thickness={1.5}
            borderRadius={16}
            className="h-full"
          >
            <div class="h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-4 hover:border-[#a476ff45] transition-colors duration-300">
              <h2 class="text-xl md:text-2xl font-medium text-[var(--white)]">
                Testing &amp; CI
              </h2>
              <ul class="space-y-2.5 text-sm text-[var(--white-icon)]">
                {
                  dvldProject.testingAndCi.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-[var(--sec)] mt-0.5" aria-hidden="true">
                        •
                      </span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </ElectricBorder>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
