---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import SpecularButton from "@/React/SpecularButton.tsx";
import ShinyText from "@/React/ShinyText.tsx";
import { dvldProject } from "@/data/portfolio";
---

<Layout
  title="DVLD System — Architecture & Case Study | Ayhm Mohammed Obeidat"
  description="Detailed technical overview of the DVLD Driving & Vehicle License Department System built by Ayhm Mohammed Obeidat with .NET 8, ASP.NET Core Web API, EF Core, SQL Server, and React."
>
  <Nav />

  <main class="text-[var(--white)] pt-12 md:pt-32 pb-16">
    <div class="max-w-5xl mx-auto space-y-12">
      <!-- Breadcrumb / Back -->
      <div>
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-sm text-[var(--white-icon)] hover:text-[var(--white)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] rounded-md px-1"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-4"
            aria-hidden="true"
          >
            <path
              d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"
            ></path>
          </svg>
          <span>Back to Portfolio</span>
        </a>
      </div>

      <!-- Header -->
      <header class="space-y-5">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-sm md:text-base text-[var(--sec)] shiny-sec">
            Project Case Study
          </span>
          <span
            class="text-xs font-mono text-[var(--white-icon)] px-2.5 py-1 rounded-md bg-[#1414149c] border border-[var(--white-icon-tr)]"
          >
            Reference Commit: {dvldProject.commitHash}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium leading-tight">
          <ShinyText
            text={dvldProject.name}
            color="#d9d9d9"
            shineColor="#ffffff"
            speed={4}
            shineWidth={70}
            softness={0.8}
            trigger="loop"
            delay={0.7}
            angle={120}
            bands={1}
            glow={0}
            direction="left"
            easing="smooth"
          />
        </h1>

        <p class="text-base md:text-xl text-[var(--white-icon)] leading-relaxed max-w-4xl">
          {dvldProject.description}
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <SpecularButton
            client:load
            target="_blank"
            rel="noopener noreferrer"
            href={dvldProject.repoUrl}
            size="md"
            radius={14}
            tint="#a476ff"
            tintOpacity={0.14}
            textColor="#f5f5f5"
            lineColor="#a476ff"
            baseColor="#525252"
            intensity={1}
            idleIntensity={0.45}
            shineSize={10}
            shineFade={34}
            thickness={1.2}
            glow={1}
            followMouse
            proximity={250}
            className="font-semibold"
          >
            <span>View Source Code</span>
          </SpecularButton>
          <SpecularButton
            client:load
            target="_blank"
            rel="noopener noreferrer"
            href={dvldProject.commitUrl}
            size="md"
            radius={14}
            tint="#ffffff"
            tintOpacity={0.04}
            textColor="#f5f5f5"
            lineColor="#ffffff"
            baseColor="#525252"
            intensity={1}
            idleIntensity={0.35}
            shineSize={10}
            shineFade={34}
            thickness={1.2}
            glow={1}
            followMouse
            proximity={250}
            className="font-mono"
          >
            <span>View Commit ({dvldProject.commitShort})</span>
          </SpecularButton>
        </div>
      </header>

      <!-- Technologies -->
      <section class="pt-8 border-t border-[#ffffff10] space-y-6">
        <h2 class="text-2xl md:text-3xl font-medium">Technologies Used</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6">
            <h3 class="text-sm uppercase tracking-wider text-[var(--sec)] mb-3 font-semibold">
              Backend &amp; Persistence
            </h3>
            <ul class="flex flex-wrap gap-2">
              {
                dvldProject.backendTechnologies.map((tech) => (
                  <li class="px-3 py-1.5 rounded-lg bg-[#1a1a1a] border border-[#ffffff10] text-sm text-[var(--white)]">
                    {tech}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6">
            <h3 class="text-sm uppercase tracking-wider text-[var(--white-icon)] mb-3 font-semibold">
              ClientApp Frontend
            </h3>
            <ul class="flex flex-wrap gap-2">
              {
                dvldProject.frontendTechnologies.map((tech) => (
                  <li class="px-3 py-1.5 rounded-lg bg-[#1a1a1a] border border-[#ffffff10] text-sm text-[var(--white-icon)]">
                    {tech}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- Architecture Highlights -->
      <section class="pt-8 border-t border-[#ffffff10] space-y-6">
        <h2 class="text-2xl md:text-3xl font-medium">Architecture Highlights</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            dvldProject.architectureLayers.map((layer) => (
              <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-2">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-lg font-semibold text-[var(--white)]">
                    {layer.name}
                  </h3>
                  <span class="text-xs font-mono text-[var(--sec)] px-2 py-0.5 rounded bg-[#1a1a1a] border border-[#ffffff10]">
                    {layer.project}
                  </span>
                </div>
                <p class="text-sm text-[var(--white-icon)] leading-relaxed">
                  {layer.description}
                </p>
              </div>
            ))
          }
        </div>

        <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-[var(--white)] mb-4">
            Key Design Patterns &amp; Practices
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {
              dvldProject.architecturePrinciples.map((item) => (
                <li class="flex items-center gap-2 text-sm text-[var(--white-icon)]">
                  <span class="text-[var(--sec)]" aria-hidden="true">•</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Verified Capabilities -->
      <section class="pt-8 border-t border-[#ffffff10] space-y-6">
        <h2 class="text-2xl md:text-3xl font-medium">Verified Capabilities</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            dvldProject.capabilities.map((cap) => (
              <li class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl px-4 py-3 text-sm text-[var(--white)] flex items-center gap-2.5">
                <span class="size-2 rounded-full bg-[var(--sec)] flex-shrink-0" aria-hidden="true" />
                <span>{cap}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Security & Testing -->
      <section class="pt-8 border-t border-[#ffffff10] grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-4">
          <h2 class="text-xl md:text-2xl font-medium">
            Security &amp; Session Management
          </h2>
          <ul class="space-y-2.5 text-sm text-[var(--white-icon)]">
            {
              dvldProject.securityFeatures.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--sec)] mt-0.5" aria-hidden="true">•</span>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-4">
          <h2 class="text-xl md:text-2xl font-medium">Testing &amp; CI</h2>
          <ul class="space-y-2.5 text-sm text-[var(--white-icon)]">
            {
              dvldProject.testingAndCi.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--sec)] mt-0.5" aria-hidden="true">•</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
