---
import { personalInfo } from "../data/portfolio";
import MagicRings from "../React/MagicRings.tsx";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${personalInfo.fullName} | ${personalInfo.title}`,
  description = "Portfolio of Ayhm Mohammed Obeidat, a .NET Backend Developer focused on C#, ASP.NET Core Web API, Entity Framework Core, SQL Server, and backend architecture.",
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: personalInfo.fullName,
  jobTitle: personalInfo.title,
  email: personalInfo.emailHref,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Amman",
    addressCountry: "JO",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Jordan University of Science and Technology (JUST)",
  },
  sameAs: [personalInfo.github],
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.image.png" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content={`${personalInfo.fullName} Portfolio`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.image.png" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-6 overflow-x-hidden">
    <div
      class="hidden lg:block fixed inset-0 pointer-events-none z-0 overflow-hidden"
      aria-hidden="true"
    >
      <MagicRings
        client:media="(min-width: 1024px)"
        color="#f43f5e"
        colorTwo="#60a5fa"
        motion="ripple"
        ringCount={6}
        speed={0.7}
        lineThickness={1.15}
        glow={0.35}
        hoverScale={1.12}
        clickBurst
        baseRadius={0.2}
        radiusStep={0.14}
        expansion={0.24}
        taper={1.25}
        rotation={0}
        spin={0}
        tilt={0}
        dispersion={0}
        grain={0}
        opacity={0.34}
        followMouse={false}
        mouseInfluence={0.2}
        hoverIntensity={1}
        parallax={0.05}
        intro
      />
    </div>

    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --component-bg: rgba(20, 20, 20, 0.85);
    --container: #141414;
    --line: #2a2a2a;
    --pink: #a476ff;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
