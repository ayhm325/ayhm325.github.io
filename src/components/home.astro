---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import FallingText from "../React/FallingText.tsx";
import MaskedHeading from "../React/MaskedHeading.tsx";
import { personalInfo, heroContent } from "../data/portfolio";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:pt-36 md:pb-16 pb-12">
    <div class="text-left space-y-5">
      <div
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm md:text-base text-[var(--white-icon)]"
      >
        <span class="text-[var(--white)] font-medium">
          {personalInfo.fullName}
        </span>
        <span class="text-[var(--sec)]" aria-hidden="true">/</span>
        <span>{personalInfo.title}</span>
        <span class="text-[var(--sec)]" aria-hidden="true">/</span>
        <span>{personalInfo.location}</span>
      </div>

      <div class="space-y-5">
        <MaskedHeading
          client:load
          tag="h1"
          text={heroContent.heading}
          fillScale={1.25}
          parallax={26}
          reveal="scale"
          trigger="mount"
          spotlight={false}
          spotlightRadius={180}
          outline={false}
          duration={1.1}
          stagger={0.09}
          drift={18}
          hoverZoom={0}
          align="left"
          brightness={1}
          saturation={1}
          grayscale={false}
          outlineWidth={1}
          weight={700}
          tracking={-0.03}
          lineHeight={1.06}
          textScale={0.056}
          tint="#f43f5e"
        />
        <div class="h-[170px] sm:h-[145px] md:h-[160px] max-w-3xl">
          <FallingText
            client:load
            text={heroContent.supportingText}
            highlightWords={[".NET", "REST", "APIs,", "reliable", "secure"]}
            trigger="hover"
            fontSize="clamp(1rem, 1.5vw, 1.25rem)"
            gravity={1}
            restoreDelay={2}
            variant="text"
            split="words"
            order="random"
            bounciness={0.2}
            scatter={0.5}
            stagger={0.03}
            cursorPush={0.5}
            mouseConstraintStiffness={0.2}
            accentColor="#a476ff"
            textColor="var(--white-icon)"
            align="left"
            draggable
            wireframes={false}
          />
        </div>
      </div>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="flex justify-center w-full max-w-[290px] sm:max-w-[340px] md:max-w-none md:w-full h-[260px] md:h-[292px] pt-3 md:pt-9 lg:ml-10 rounded-2xl overflow-hidden"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiny-sec {
      animation: none;
      background-position: 0% 50%;
    }
  }
</style>
