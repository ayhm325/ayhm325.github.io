---
interface TechItem {
  label: string;
  badge: string;
  svgPath?: string;
}

const technologies: TechItem[] = [
  { label: "C#", badge: "C#" },
  { label: ".NET 8", badge: ".NET" },
  { label: "ASP.NET Core", badge: "API" },
  { label: "EF Core", badge: "EF" },
  { label: "SQL Server", badge: "SQL" },
  { label: "LINQ", badge: "LINQ" },
  { label: "JWT Auth", badge: "JWT" },
  { label: "Git", badge: "Git", svgPath: "/svg/git.svg" },
  { label: "React", badge: "React", svgPath: "/svg/react.svg" },
  { label: "TypeScript", badge: "TS", svgPath: "/svg/typeScript.svg" },
  { label: "Swagger / OpenAPI", badge: "OAI" },
  { label: "xUnit", badge: "xUnit" },
  { label: "Azure DevOps", badge: "CI" },
];
---

<div class="relative overflow-x-hidden py-8" aria-label="Core technologies">
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-24 md:w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-24 md:w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"
  >
  </div>

  <div class="flex animate-scroll w-max will-change-transform">
    {
      [...technologies, ...technologies].map((tech, index) => (
        <div
          class="flex items-center gap-2.5 pr-10 md:pr-16 group transition-all duration-300"
          aria-hidden={index >= technologies.length ? "true" : "false"}
        >
          {tech.svgPath ? (
            <img
              src={tech.svgPath}
              alt={index < technologies.length ? tech.label : ""}
              class="h-6 w-6 object-contain transition-transform group-hover:scale-110 opacity-65"
              width="24"
              height="24"
              loading={index < technologies.length ? "eager" : "lazy"}
              decoding="async"
            />
          ) : (
            <span
              class="inline-flex items-center justify-center h-6 min-w-[1.75rem] px-1.5 rounded-md border border-[var(--white-icon-tr)] bg-[#1414149c] text-[11px] font-semibold tracking-tight text-[var(--sec)] opacity-85 transition-transform group-hover:scale-110"
              aria-hidden="true"
            >
              {tech.badge}
            </span>
          )}
          <span class="text-base md:text-lg font-medium text-[var(--white-icon)] group-hover:text-[var(--white)] transition-colors whitespace-nowrap">
            {tech.label}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation: none;
    }
  }
</style>
