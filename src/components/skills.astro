---
import ShinyText from "../React/ShinyText.tsx";
import ElectricBorder from "../React/ElectricBorder.tsx";
import { skillGroups } from "../data/portfolio";

const groupIcons: Record<string, string> = {
  "Backend Development": `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--sec)]"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>`,
  Database: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--sec)]"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>`,
  "Programming Fundamentals": `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--sec)]"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  "API & Security": `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--sec)]"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>`,
  Tools: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--sec)]"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
};
---

<section
  id="skills"
  class="py-12 md:py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-lg mb-2">
      <ShinyText
        text="Capabilities"
        color="#a476ff"
        shineColor="#f3ecff"
        speed={4}
        shineWidth={70}
        softness={0.8}
        trigger="loop"
        delay={0.7}
        angle={120}
        bands={1}
        glow={0}
        direction="left"
        easing="smooth"
      />
    </p>
    <h2 class="text-3xl md:text-5xl font-medium mb-8">
      <ShinyText
        text="Technical Skills"
        color="#d9d9d9"
        shineColor="#ffffff"
        speed={4}
        shineWidth={70}
        softness={0.8}
        trigger="loop"
        delay={0.7}
        angle={120}
        bands={1}
        glow={0}
        direction="left"
        easing="smooth"
      />
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        skillGroups.map((group) => (
          <ElectricBorder
            client:visible
            color="#7df9ff"
            speed={1}
            chaos={0.5}
            spread={0.6}
            strands={3}
            thickness={1.5}
            borderRadius={16}
            className="h-full"
          >
            <div class="h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 hover:border-[#a476ff45] transition-colors duration-300">
              <div class="flex items-center gap-3 mb-4">
                <Fragment set:html={groupIcons[group.title] ?? ""} />
                <h3 class="text-lg font-semibold text-[var(--white)]">
                  {group.title}
                </h3>
              </div>
              <ul class="flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <li class="px-3 py-1.5 rounded-lg bg-[#1a1a1a] border border-[#ffffff10] text-sm text-[var(--white-icon)] hover:text-[var(--white)] hover:border-[var(--white-icon-tr)] transition-colors">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          </ElectricBorder>
        ))
      }
    </div>
  </div>
</section>
