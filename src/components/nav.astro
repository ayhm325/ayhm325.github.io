---
interface NavItem {
  label: string;
  href: string;
  sectionId: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "/#home",
    sectionId: "home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "About",
    href: "/#about",
    sectionId: "about",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12ZM12 14C7.58172 14 4 17.5817 4 22H6C6 18.6863 8.68629 16 12 16C15.3137 16 18 18.6863 18 22H20C20 17.5817 16.4183 14 12 14Z"></path></svg>`,
  },
  {
    label: "Skills",
    href: "/#skills",
    sectionId: "skills",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z"></path></svg>`,
  },
  {
    label: "Project",
    href: "/#projects",
    sectionId: "projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Contact",
    href: "/#contact",
    sectionId: "contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    aria-label="Primary navigation"
    class="pill-nav fixed left-1/2 -translate-x-1/2 z-[100] md:top-6 md:bottom-auto bottom-0 w-[80%]"
  >
    <div class="pill-nav-inner flex w-full items-center justify-between md:px-3 md:py-2 px-3 py-2.5 gap-3">
      <!-- Split Left: Brand Pill -->
      <a
        href="/#home"
        data-section="home"
        aria-label="Ayhm Obeidat Home"
        class="pill-brand hidden md:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-sm font-semibold text-[var(--white)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
      >
        <span class="size-2 rounded-full bg-[var(--sec)] shadow-[0_0_10px_var(--sec)]"></span>
        <span class="tracking-tight">Ayhm</span>
      </a>

      <!-- Split Right: Pill Navigation Items -->
      <ul
        class="flex w-full md:w-auto justify-between md:justify-end md:gap-1.5 gap-1 items-center"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none">
              <a
                href={item.href}
                data-section={item.sectionId}
                class="pill-link flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 text-[var(--white-icon)] hover:text-white text-[11px] sm:text-xs md:text-sm font-medium relative group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] rounded-full md:px-4 md:py-2 px-1 py-1.5 overflow-hidden"
              >
                <span class="pill-fill" aria-hidden="true" />
                <span class="md:hidden relative z-10 flex items-center justify-center w-5 h-5">
                  <Fragment set:html={item.icon} />
                </span>
                <span class="relative z-10 hidden md:inline-block">{item.label}</span>
                <span class="relative z-10 md:hidden">{item.label}</span>
                <span
                  class="nav-indicator hidden md:inline-block relative z-10 w-1.5 h-1.5 rounded-full bg-[var(--sec)]"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  /* Glass Pill Surface + Intro Animation */
  .pill-nav {
    transform: translateX(-50%);
    background: rgba(18, 18, 20, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      0 10px 30px -10px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    animation: pillNavIntro 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .pill-nav.scrolling {
    background: rgba(14, 14, 16, 0.86);
    border-color: rgba(164, 118, 255, 0.25);
    box-shadow:
      0 14px 36px -10px rgba(0, 0, 0, 0.75),
      0 0 24px -12px rgba(164, 118, 255, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .pill-brand {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .pill-brand:hover {
    background: rgba(164, 118, 255, 0.14);
    border-color: rgba(164, 118, 255, 0.35);
    transform: scale(1.04);
  }

  /* Pill Link: hoverEffect="fill", bounce & stretch */
  .pill-link {
    transition:
      color 0.25s ease,
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center;
  }

  .pill-link .pill-fill {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(
      135deg,
      rgba(164, 118, 255, 0.24),
      rgba(255, 255, 255, 0.1)
    );
    border: 1px solid rgba(255, 255, 255, 0.14);
    transform: translateY(105%) scaleX(0.72) scaleY(0.8);
    opacity: 0;
    transition:
      transform 0.48s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.25s ease;
    pointer-events: none;
  }

  .pill-link:hover {
    transform: scaleX(1.04) scaleY(0.98);
  }

  .pill-link:active {
    transform: scaleX(0.96) scaleY(1.03);
  }

  .pill-link:hover .pill-fill {
    transform: translateY(0) scaleX(1) scaleY(1);
    opacity: 1;
  }

  /* Active Pill + Dot Indicator */
  .pill-link .nav-indicator {
    transform: scale(0);
    opacity: 0;
    width: 0;
    margin-left: -4px;
    box-shadow: 0 0 8px var(--sec);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.25s ease,
      width 0.3s ease,
      margin 0.3s ease;
  }

  .pill-link.active {
    color: #ffffff !important;
  }

  .pill-link.active .pill-fill {
    transform: translateY(0) scaleX(1) scaleY(1);
    opacity: 1;
    background: linear-gradient(
      135deg,
      rgba(164, 118, 255, 0.28),
      rgba(164, 118, 255, 0.1)
    );
    border-color: rgba(164, 118, 255, 0.45);
  }

  .pill-link.active .nav-indicator {
    transform: scale(1);
    opacity: 1;
    width: 6px;
    margin-left: 0;
  }

  @keyframes pillNavIntro {
    from {
      opacity: 0;
      transform: translate(-50%, -18px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill-nav,
    .pill-link,
    .pill-link .pill-fill,
    .pill-link .nav-indicator,
    .pill-brand {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 767px) {
    .pill-nav {
      width: 100% !important;
      transform: translateX(-50%);
      bottom: 0;
      left: 50%;
      position: fixed;
      border-radius: 1.25rem 1.25rem 0 0;
      border-color: rgba(255, 255, 255, 0.12);
      animation: none;
    }

    .pill-nav.scrolling {
      border-radius: 1.25rem 1.25rem 0 0;
    }

    body {
      padding-bottom: 70px;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const maxScroll = 1000;
  let rafId: number | null = null;

  function updateNav() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");

      const scrollProgress = Math.min(window.scrollY / maxScroll, 1);
      const easeProgress = 1 - Math.pow(1 - scrollProgress, 4);

      const minWidth = 580;
      const maxWidth = Math.min(window.innerWidth * 0.8, 920);
      const currentWidth = Math.max(
        minWidth,
        maxWidth - (maxWidth - minWidth) * easeProgress,
      );

      if (window.innerWidth >= 768) {
        nav?.style.setProperty("width", `${currentWidth}px`);
      }
    } else {
      nav?.classList.remove("scrolling");
      if (window.innerWidth >= 768) {
        nav?.style.setProperty("width", "min(80%, 920px)");
      }
    }
    rafId = null;
  }

  if (window.innerWidth >= 768) {
    nav?.style.setProperty("width", "min(80%, 920px)");
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true },
  );

  document.querySelectorAll('nav a[href^="/#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const target = e.currentTarget as HTMLAnchorElement;
      const sectionId = target.getAttribute("data-section") || "";
      const targetElement = document.getElementById(sectionId);
      if (targetElement && window.location.pathname === "/") {
        e.preventDefault();
        targetElement.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a.pill-link[data-section]");
    if (!sections.length) return;

    const observerOptions = {
      rootMargin: "-20% 0px -55% 0px",
      threshold: 0.1,
    };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("active"));
          const id = entry.target.getAttribute("id");
          const activeLink = document.querySelector(
            `nav a.pill-link[data-section="${id}"]`,
          );
          if (activeLink) {
            activeLink.classList.add("active");
          }
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach((section) => observer.observe(section));
  });
</script>
