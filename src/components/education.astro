---
import ShinyText from "../React/ShinyText.tsx";
import ElectricBorder from "../React/ElectricBorder.tsx";
import MaskedHeading from "../React/MaskedHeading.tsx";
import SpecularButton from "../React/SpecularButton.tsx";
import { educationInfo } from "../data/portfolio";
---

<section
  id="education"
  class="py-12 md:py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-lg mb-2">
      <ShinyText
        text="Academic"
        color="#a476ff"
        shineColor="#f3ecff"
        speed={4}
        shineWidth={70}
        softness={0.8}
        trigger="loop"
        delay={0.7}
        angle={120}
        bands={1}
        glow={0}
        direction="left"
        easing="smooth"
      />
    </p>
    <div class="mb-8">
      <MaskedHeading
        client:visible
        tag="h2"
        text="Education"
        fillScale={1.25}
        parallax={26}
        reveal="scale"
        trigger="view"
        spotlight={false}
        spotlightRadius={180}
        outline={false}
        duration={1.1}
        stagger={0.09}
        drift={18}
        hoverZoom={0}
        align="left"
        brightness={1}
        saturation={1}
        grayscale={false}
        outlineWidth={1}
        weight={700}
        tracking={-0.03}
        lineHeight={1.06}
        textScale={0.052}
        tint="#f43f5e"
      />
    </div>

    <ElectricBorder
      client:visible
      color="#7df9ff"
      speed={1}
      chaos={0.5}
      spread={0.6}
      strands={3}
      thickness={1.5}
      borderRadius={16}
    >
      <div
        class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 hover:border-[#a476ff45] transition-colors duration-300"
      >
        <div class="space-y-1.5">
          <h3 class="text-xl md:text-2xl font-semibold text-[var(--white)]">
            {educationInfo.institution}
          </h3>
          <p class="text-base md:text-lg text-[var(--white-icon)]">
            {educationInfo.degree}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 md:text-right">
          <SpecularButton
            client:visible
            size="sm"
            radius={10}
            tint="#ffffff"
            tintOpacity={0.04}
            textColor="#a1a1aa"
            lineColor="#ffffff"
            baseColor="#525252"
            intensity={1}
            idleIntensity={0.35}
            shineSize={10}
            shineFade={34}
            thickness={1.2}
            glow={1}
            followMouse
            proximity={250}
            className="!px-3 !py-1.5 !text-sm !font-normal !cursor-default"
          >
            {educationInfo.location}
          </SpecularButton>
          <SpecularButton
            client:visible
            size="sm"
            radius={10}
            tint="#a476ff"
            tintOpacity={0.12}
            textColor="#a476ff"
            lineColor="#a476ff"
            baseColor="#525252"
            intensity={1}
            idleIntensity={0.45}
            shineSize={10}
            shineFade={34}
            thickness={1.2}
            glow={1}
            followMouse
            proximity={250}
            className="!px-3 !py-1.5 !text-sm !font-medium !cursor-default"
          >
            {educationInfo.year}
          </SpecularButton>
        </div>
      </div>
    </ElectricBorder>
  </div>
</section>
