---
import LikeButton from "../React/LikeButton.tsx";
import ElectricLine from "../React/ElectricLine.tsx";
import SpecularButton from "../React/SpecularButton.tsx";
import { personalInfo } from "../data/portfolio";

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    href: personalInfo.github,
    label: "GitHub",
    external: true,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7" aria-hidden="true"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>',
  },
  {
    href: personalInfo.emailHref,
    label: "Email",
    external: false,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7" aria-hidden="true"><path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/></svg>',
  },
  {
    href: personalInfo.phoneHref,
    label: "Phone",
    external: false,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
];
---

<footer class="w-full pb-12">
  <ElectricLine
    client:visible
    color="#7df9ff"
    speed={1}
    chaos={0.5}
    spread={0.6}
    strands={3}
    thickness={1.5}
    className="mb-10"
  />
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 items-center">
      <!-- Left: Social Icons + LikeButton -->
      <div class="flex flex-col md:items-start items-center gap-4">
        <div class="flex items-center gap-4">
          {
            socialLinks.map((link) => (
              <SpecularButton
                client:visible
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                ariaLabel={link.label}
                size="sm"
                radius={12}
                tint="#ffffff"
                tintOpacity={0.04}
                textColor="#f5f5f5"
                lineColor="#ffffff"
                baseColor="#525252"
                intensity={1}
                idleIntensity={0.35}
                shineSize={10}
                shineFade={34}
                thickness={1.2}
                glow={1}
                followMouse
                proximity={250}
                className="!p-2.5"
              >
                <Fragment set:html={link.icon} />
              </SpecularButton>
            ))
          }
        </div>
        <LikeButton client:load />
      </div>

      <!-- Center: Tech Badges -->
      <div class="flex flex-row flex-wrap md:flex-col items-center justify-center gap-3">
        {
          [
            {
              desc: "Built with",
              name: "Astro",
              icon: "/svg/astro.svg",
              alt: "Astro Logo",
            },
            {
              desc: "Styled with",
              name: "TailwindCSS",
              icon: "/svg/tailwindcss.svg",
              alt: "TailwindCSS Logo",
            },
          ].map((tech) => (
            <SpecularButton
              client:visible
              size="sm"
              radius={999}
              tint="#ffffff"
              tintOpacity={0.04}
              textColor="#f5f5f5"
              lineColor="#ffffff"
              baseColor="#525252"
              intensity={1}
              idleIntensity={0.35}
              shineSize={10}
              shineFade={34}
              thickness={1.2}
              glow={1}
              followMouse
              proximity={250}
              className="!px-3.5 !py-1.5 !cursor-default"
            >
              <span class="text-[var(--white-icon)] text-xs sm:text-sm font-normal">
                {tech.desc}
              </span>
              <img
                src={tech.icon}
                alt={tech.alt}
                class="h-4 w-4 object-contain filter brightness-0 invert opacity-70"
                loading="lazy"
              />
              <span class="text-[var(--white)] text-xs sm:text-sm font-medium">
                {tech.name}
              </span>
            </SpecularButton>
          ))
        }
      </div>

      <!-- Right: Author & Role -->
      <div class="flex flex-col items-center md:items-end gap-1.5 text-center md:text-right">
        <p class="text-lg font-semibold tracking-tight text-[var(--white)]">
          {personalInfo.fullName}
        </p>
        <p class="text-sm font-medium text-[#d4d4d8]">
          {personalInfo.title}
        </p>
        <p class="text-xs tracking-wide text-[var(--white-icon)]">
          {personalInfo.location}
        </p>
      </div>
    </div>

    <div class="mt-10">
      <ElectricLine
        client:visible
        color="#7df9ff"
        speed={1}
        chaos={0.5}
        spread={0.6}
        strands={3}
        thickness={1.5}
        className="mb-6"
      />
      <p class="text-center text-sm text-[var(--white-icon)]">
        <span>
          Copyright &copy; {currentYear} {personalInfo.fullName}.
        </span>
      </p>
    </div>
  </div>
</footer>
