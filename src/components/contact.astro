---
import { contactContent, personalInfo } from "../data/portfolio";
---

<section
  id="contact"
  class="w-full py-12 md:py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">Get in touch</p>
    <h2 class="text-3xl md:text-5xl font-medium mb-6">
      {contactContent.title}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div class="space-y-6">
        <p class="text-base md:text-lg text-[var(--white-icon)] leading-relaxed">
          {contactContent.description}
        </p>

        <div class="space-y-3 text-sm md:text-base">
          <div class="flex items-center gap-3">
            <span class="text-[var(--white-icon)] w-20">Location</span>
            <span class="text-[var(--white)] font-medium">
              {personalInfo.location}
            </span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[var(--white-icon)] w-20">Email</span>
            <a
              href={personalInfo.emailHref}
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors break-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] rounded"
            >
              {personalInfo.email}
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[var(--white-icon)] w-20">Phone</span>
            <a
              href={personalInfo.phoneHref}
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] rounded"
            >
              {personalInfo.phone}
            </a>
          </div>
        </div>
      </div>

      <div
        class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 space-y-4"
      >
        <h3 class="text-lg font-semibold text-[var(--white)]">
          Direct Channels
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href={personalInfo.emailHref}
            class="flex items-center justify-center gap-2.5 px-4 py-3 rounded-xl bg-[var(--sec)] text-[#101010] font-semibold text-sm hover:opacity-90 transition duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
              ></path>
            </svg>
            <span>Send Email</span>
          </a>

          <a
            href={personalInfo.phoneHref}
            class="flex items-center justify-center gap-2.5 px-4 py-3 rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a] text-[var(--white)] hover:bg-[var(--white-icon-tr)] font-medium text-sm transition duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 text-[var(--sec)]"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <span>Call Phone</span>
          </a>

          <a
            target="_blank"
            rel="noopener noreferrer"
            href={personalInfo.github}
            class="flex items-center justify-center gap-2.5 px-4 py-3 rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a] text-[var(--white)] hover:bg-[var(--white-icon-tr)] font-medium text-sm transition duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
              ></path>
            </svg>
            <span>GitHub Profile</span>
          </a>

          <a
            href={personalInfo.cvPath}
            download={personalInfo.cvFileName}
            class="flex items-center justify-center gap-2.5 px-4 py-3 rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a] text-[var(--white)] hover:bg-[var(--white-icon-tr)] hover:border-[var(--sec)] font-medium text-sm transition duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 text-[var(--sec)]"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" x2="12" y1="15" y2="3"></line>
            </svg>
            <span>Download CV</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
